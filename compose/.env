# Compose
COMPOSE_PROJECT_NAME=gwent-oss
RESTART_POLICY=unless-stopped
NETWORK_NAME=gwent-oss
NETWORK_EXTERNAL=false
LOG_MAX_FILE=5
LOG_MAX_SIZE=10m

# Shared
HOST_NAME=localhost
PORT=443

# gwent-oss
GWENT_OSS_TAG=latest # override to target specific version (e.g. "0.26.0")
LOG_LEVEL=INFO # override for more verbose logging (e.g. "DEBUG" or "TRACE")
SESSION_TIMEOUT_SECONDS=1800 # 30 minutes

# MongoDB
MONGO_DB=gwent-oss

# Caddy
LOCAL_CERTS=local_certs # Use Caddy's internal SSL certs be default, set to empty string "" to have Caddy reach out to letsencrypt to create a public certificate
DEBUG="" # Set to "debug" to have the Caddy container output more detailed logging information
LIMIT_HTTP_EVENTS_NOT_AUTH=2
LIMIT_HTTP_EVENTS_YES_AUTH=5
LIMIT_HTTP_WINDOW_NOT_AUTH=1s
LIMIT_HTTP_WINDOW_YES_AUTH=1s
LIMIT_HTTP_BURST_NOT_AUTH=5
LIMIT_HTTP_BURST_YES_AUTH=10
LIMIT_WS_EVENTS_NOT_AUTH=1
LIMIT_WS_EVENTS_YES_AUTH=5
LIMIT_WS_WINDOW_NOT_AUTH=10s
LIMIT_WS_WINDOW_YES_AUTH=10s
LIMIT_WS_BURST_NOT_AUTH=1
LIMIT_WS_BURST_YES_AUTH=5

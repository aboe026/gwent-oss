{
  # If value is "local_certs" Caddy will use internal CA for SSL cert.
  # If set to empty string "" Caddy will reach out to letencrypt to create a public SSL cert.
  {$LOCAL_CERTS}

  # set to "debug" to get higher level debugging output.
  {$DEBUG}

  # Structured JSON logs with rotation
  log {
    format json
    output file /data/access.log {
      roll_size 10mb
      roll_keep 10
      roll_keep_for 720h
    }
  }
}

{$HOST_NAME} {
  # --- Security Headers ---
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  }

  # --- Compression ---
  encode gzip zstd

  # --- Block dangerous HTTP methods ---
  @blocked_methods {
    method TRACE
    method TRACK
    method OPTIONS
  }
  respond @blocked_methods 405


  # --- Reverse proxy routes ---
  handle /graphql {
    reverse_proxy api:4000
  }

  handle /subscribe {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy ui:3000
  }

  # --- Unified error handler ---
  handle_errors {
    respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
  }
}

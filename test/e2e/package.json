{
  "name": "@gwent/e2e-tests",
  "version": "0.3.2",
  "author": "Adam Boe",
  "description": "E2E browser testing for Gwent website",
  "scripts": {
    "build": "yarn g:tsc --build",
    "build-image": "docker build --tag=testcafe/testcafe:${IMAGE_TAG:-yarn-pnp} --progress=plain ${BUILD_OPTIONS:-} .",
    "clean": "yarn g:rimraf build tsconfig.tsbuildinfo",
    "debug": "yarn start --debug-on-fail",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "start": "yarn build && cross-env START_APP=true testcafe --config-file=build/.testcaferc.js",
    "start-gwent": "cd $PROJECT_CWD && cross-env SESSION_TIMEOUT_SECONDS=20 MONGO_DB=gwent-e2e yarn start",
    "test": "testcafe --config-file=build/.testcaferc.js --debug-on-fail",
    "start-docker": "docker run --rm -v $PROJECT_CWD:/gwent -w /gwent/test/e2e -it testcafe/testcafe:yarn-pnp chromium build/tests --config-file=build/.testcaferc.js",
    "watch": "yarn g:tsc --build --watch"
  },
  "dependencies": {
    "@gwent/constants": "workspace:*",
    "@gwent/db-profiler": "workspace:*",
    "@gwent/env": "workspace:*",
    "@gwent/graphql-schema": "workspace:*",
    "@gwent/utils": "workspace:*",
    "cross-env": "7.0.3",
    "graphql": "16.8.1",
    "graphql-request": "6.1.0",
    "mongodb": "6.5.0",
    "testcafe": "3.6.0",
    "url-join": "4.0.1"
  },
  "devDependencies": {
    "@types/url-join": "4.0.3"
  }
}

{
  "name": "@gwent-oss/test-e2e",
  "version": "0.25.0",
  "author": "Adam Boe",
  "description": "E2E browser testing for gwent-oss website",
  "scripts": {
    "build": "yarn g:npm-run-all --sequential build-tsc remove-context-overrides",
    "build-all": "yarn g:recurse @gwent-oss/test-e2e run build",
    "build-tsc": "yarn g:tsc --build",
    "build-image": "docker build --tag=testcafe/testcafe:${IMAGE_TAG:-yarn-pnp} --progress=plain ${BUILD_OPTIONS:-} .",
    "clean": "yarn g:rimraf build tsconfig.tsbuildinfo",
    "debug": "yarn start --debug-on-fail",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "remove-context-overrides": "yarn g:ts-node scripts/remove-context-overrides.ts",
    "start": "yarn g:npm-run-all --sequential build start-testcafe",
    "start-testcafe": "cross-env START_APP=true testcafe --config-file=build/.testcaferc.js",
    "start-app": "cd $PROJECT_CWD && cross-env SESSION_TIMEOUT_SECONDS=60 MONGO_DB=gwent-oss-e2e yarn start",
    "test": "cross-env MONGO_DB=gwent-oss testcafe --config-file=build/.testcaferc.js --debug-on-fail",
    "start-docker": "yarn remove-context-overrides && docker run --rm -v $PROJECT_CWD:/gwent-oss -w /gwent-oss/test/e2e -it testcafe/testcafe:yarn-pnp chromium build/tests --config-file=build/.testcaferc.js",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-built",
    "watch-built": "yarn g:ts-node scripts/wait-for-initial-build.ts && yarn g:nodemon --watch build --exec 'yarn remove-context-overrides'",
    "watch-tsc": "yarn build-tsc --watch"
  },
  "dependencies": {
    "@gwent-oss/constants": "workspace:*",
    "@gwent-oss/db-profiler": "workspace:*",
    "@gwent-oss/env": "workspace:*",
    "@gwent-oss/graphql-schema": "workspace:*",
    "@gwent-oss/node-client": "workspace:*",
    "@gwent-oss/test-utils": "workspace:*",
    "@gwent-oss/utils": "workspace:*",
    "cookie": "1.1.1",
    "cross-env": "10.1.0",
    "graphql": "16.14.2",
    "graphql-request": "6.1.0",
    "graphql-ws": "6.2.0",
    "mongodb": "7.5.0",
    "testcafe": "3.7.6",
    "url-join": "4.0.1",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/url-join": "4.0.3",
    "@types/ws": "8.18.1",
    "replace-in-file": "7.2.0"
  }
}

{
  "name": "@gwent/api",
  "version": "0.1.0",
  "author": "Adam Boe",
  "description": "GraphQL backend to play Gwent.",
  "main": "src/api.ts",
  "scripts": {
    "build": "yarn generate-graphql-typings && yarn build-tsc",
    "build-tsc": "yarn g:tsc --build",
    "build-image": "docker build --tag=gwent-api:${IMAGE_TAG:-latest} --progress=plain --file=Dockerfile --build-arg VERSION=${IMAGE_VERSION:-dev} --build-arg BUILD=${IMAGE_BUILD:-0} ${BUILD_OPTIONS:-} ../../",
    "clean": "yarn g:rimraf build coverage tsconfig.tsbuildinfo",
    "coverage-view": "yarn g:coverage-view",
    "generate-graphql-typings": "graphql-codegen --config codegen.ts",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "run-built": "yarn node build/src/api.js",
    "start": "yarn g:ts-node src/api.ts",
    "test-func": "yarn g:jest --test-type=func --runInBand",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-graphql-schema watch-built",
    "watch-built": "yarn g:nodemon --watch build --exec 'yarn node build/src/api.js'",
    "watch-graphql-schema": "yarn generate-graphql-typings --watch",
    "watch-tsc": "yarn g:tsc --build --watch"
  },
  "dependencies": {
    "@apollo/server": "4.5.0",
    "@graphql-codegen/typescript-mongodb": "2.4.6",
    "@gwent/env": "workspace:*",
    "body-parser": "1.20.2",
    "connection-string": "4.4.0",
    "cors": "2.8.5",
    "express": "4.18.2",
    "fs-extra": "11.1.1",
    "graphql": "16.6.0",
    "graphql-tag": "2.12.6",
    "log4js": "6.9.1",
    "mongodb": "5.1.0",
    "semver": "7.3.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "3.2.2",
    "@graphql-codegen/typescript": "3.0.2",
    "@graphql-codegen/typescript-operations": "3.0.2",
    "@graphql-codegen/typescript-react-apollo": "3.3.7",
    "@graphql-codegen/typescript-resolvers": "3.1.1",
    "@graphql-tools/schema": "10.0.0",
    "@types/body-parser": "1.19.2",
    "@types/cors": "2.8.13",
    "@types/express": "4.17.17",
    "@types/fs-extra": "11.0.1",
    "@types/jest": "29.5.0",
    "@types/semver": "7.3.13",
    "jest-junit": "15.0.0",
    "ts-jest": "29.0.5"
  }
}

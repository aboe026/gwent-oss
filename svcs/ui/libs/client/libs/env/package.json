{
  "name": "@gwent/client-env",
  "version": "0.5.0",
  "author": "Adam Boe",
  "description": "Client-side runtime dynamic environment variables",
  "type": "module",
  "main": "build/src/env.mjs",
  "types": "build/src/env.d.mts",
  "scripts": {
    "build": "yarn g:tsc --build",
    "clean": "yarn g:rimraf build coverage test-results tsconfig.tsbuildinfo",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:tsc --build --watch"
  },
  "devDependencies": {
    "@types/jest": "29.5.13",
    "jest-junit": "16.0.0",
    "ts-jest": "29.2.5"
  }
}

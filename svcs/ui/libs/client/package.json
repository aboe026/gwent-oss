{
  "name": "@gwent/client",
  "version": "0.5.0",
  "author": "Adam Boe",
  "description": "React bundle for Gwent website",
  "type": "module",
  "scripts": {
    "build": "yarn g:npm-run-all --sequential build-node build-webpack",
    "build-webpack": "cross-env NODE_OPTIONS='--loader ts-node/esm' webpack --config webpack.config.mts --mode production",
    "build-node": "yarn g:tsc --build",
    "clean": "yarn g:rimraf build coverage test-results tsconfig.tsbuildinfo && yarn workspaces foreach --worktree --parallel --interlaced run clean",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-webpack",
    "watch-tsc": "yarn g:tsc --build --watch",
    "watch-webpack": "cross-env NODE_OPTIONS='--import=tsx' webpack --config webpack.config.mts --watch --progress"
  },
  "dependencies": {
    "@apollo/client": "3.11.8",
    "@gwent/constants": "workspace:*",
    "@gwent/graphql-schema": "workspace:*",
    "@gwent/utils": "workspace:*",
    "@gwent/validators": "workspace:*",
    "graphql": "16.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.3.0",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@gwent/client-env": "workspace:*",
    "@gwent/env": "workspace:*",
    "@types/jest": "29.5.13",
    "@types/node": "22.5.5",
    "@types/react": "18.3.8",
    "@types/react-dom": "18.3.0",
    "@types/react-router-dom": "5.3.3",
    "copy-webpack-plugin": "12.0.2",
    "cross-env": "7.0.3",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.0",
    "jest-junit": "16.0.0",
    "mini-css-extract-plugin": "2.9.1",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.1",
    "tsx": "4.19.1",
    "webpack": "5.94.0",
    "webpack-cli": "5.1.4"
  },
  "workspaces": [
    "libs/*"
  ]
}

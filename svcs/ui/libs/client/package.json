{
  "name": "@gwent/client",
  "version": "0.3.1",
  "author": "Adam Boe",
  "description": "React bundle for Gwent website",
  "main": "src/index.ts",
  "scripts": {
    "build": "yarn g:tsc --build && webpack --mode=production",
    "clean": "yarn g:rimraf build coverage test-results tsconfig.tsbuildinfo && yarn workspaces foreach --worktree --parallel --interlaced run clean",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-webpack",
    "watch-tsc": "yarn g:tsc --build --watch",
    "watch-webpack": "webpack --watch --progress"
  },
  "dependencies": {
    "@apollo/client": "3.10.1",
    "@gwent/constants": "workspace:*",
    "@gwent/graphql-schema": "workspace:*",
    "@gwent/utils": "workspace:*",
    "@gwent/validators": "workspace:*",
    "graphql": "16.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.1.0",
    "react-router-dom": "6.23.0"
  },
  "devDependencies": {
    "@gwent/client-env": "workspace:*",
    "@gwent/env": "workspace:*",
    "@types/jest": "29.5.12",
    "@types/node": "20.12.7",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@types/react-router-dom": "5.3.3",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "7.1.1",
    "html-webpack-plugin": "5.6.0",
    "jest-junit": "16.0.0",
    "mini-css-extract-plugin": "2.9.0",
    "ts-jest": "29.1.2",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "webpack": "5.91.0",
    "webpack-cli": "5.1.4",
    "webpack-shell-plugin-next": "2.3.1"
  },
  "workspaces": [
    "libs/*"
  ]
}

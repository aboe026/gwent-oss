{
  "name": "@gwent/client",
  "version": "0.10.3",
  "author": "Adam Boe",
  "description": "React bundle for Gwent website",
  "main": "src/index.ts",
  "scripts": {
    "build": "yarn g:npm-run-all --sequential build-node build-webpack",
    "build-node": "yarn g:tsc --build",
    "build-webpack": "webpack --mode=production",
    "clean": "yarn g:rimraf build coverage test-results tsconfig.tsbuildinfo && yarn workspaces foreach --worktree --parallel --interlaced run clean",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-webpack",
    "watch-tsc": "yarn g:tsc --build --watch",
    "watch-webpack": "webpack --watch --progress"
  },
  "dependencies": {
    "@apollo/client": "3.12.8",
    "@gwent/constants": "workspace:*",
    "@gwent/graphql-schema": "workspace:*",
    "@gwent/utils": "workspace:*",
    "@gwent/validators": "workspace:*",
    "graphql": "16.10.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "5.4.0",
    "react-router": "7.1.4",
    "url-join": "4.0.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@gwent/client-env": "workspace:*",
    "@gwent/env": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.12.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/url-join": "4.0.3",
    "@types/ws": "8.5.14",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "7.1.2",
    "graphql-ws": "6.0.3",
    "html-webpack-plugin": "5.6.3",
    "jest-junit": "16.0.0",
    "mini-css-extract-plugin": "2.9.2",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "webpack": "5.97.1",
    "webpack-cli": "6.0.1",
    "webpack-shell-plugin-next": "2.3.2"
  },
  "workspaces": [
    "libs/*"
  ]
}

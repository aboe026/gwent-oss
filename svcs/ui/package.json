{
  "name": "@gwent/ui",
  "version": "0.2.0",
  "author": "Adam Boe",
  "description": "React frontend to play Gwent.",
  "main": "src/index.ts",
  "scripts": {
    "build": "yarn g:npm-run-all --parallel build-tsc build-client",
    "build-tsc": "yarn g:tsc --build",
    "build-client": "yarn workspaces foreach --worktree --exclude @gwent/ui --parallel --interlaced run build",
    "build-image": "docker build --tag=gwent-ui:${IMAGE_TAG:-latest} --progress=plain --file=Dockerfile --build-arg VERSION=${IMAGE_VERSION:-dev} --build-arg BUILD=${IMAGE_BUILD:-0} ${BUILD_OPTIONS:-} ../../",
    "clean": "yarn g:rimraf build coverage test-results tsconfig.tsbuildinfo && yarn workspaces foreach --worktree --parallel --interlaced run clean",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "run-built": "cross-env CLIENT_DIR=../../libs/client/build yarn node build/src/index.js",
    "start": "cross-env CLIENT_DIR=../libs/client/build yarn g:ts-node src/index.ts",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-client watch-built",
    "watch-built": "cross-env CLIENT_DIR=../../libs/client/build yarn g:nodemon --watch build --watch libs/client/build/dynamic-env.js --exec 'yarn node build/src/index.js'",
    "watch-client": "yarn workspaces foreach --worktree --exclude @gwent/ui --parallel --interlaced run watch",
    "watch-tsc": "yarn g:tsc --build --watch"
  },
  "dependencies": {
    "@gwent/env": "workspace:*",
    "@gwent/utils": "workspace:*",
    "express": "4.18.2",
    "fs-extra": "11.1.1",
    "log4js": "6.9.1",
    "replace-in-file": "7.0.2"
  },
  "devDependencies": {
    "@gwent/client": "workspace:*",
    "@types/express": "4.17.21",
    "@types/fs-extra": "11.0.3",
    "@types/jest": "29.5.7",
    "cross-env": "7.0.3",
    "jest-junit": "16.0.0",
    "ts-jest": "29.1.1"
  },
  "workspaces": [
    "libs/*"
  ]
}

{
  "name": "@witcher-3-gwent/ui",
  "version": "0.1.0",
  "author": "Adam Boe",
  "description": "React frontend to play The Witcher 3: Wild Hunt version of Gwent.",
  "main": "src/server.ts",
  "scripts": {
    "build": "yarn g:npm-run-all --parallel build-tsc build-client",
    "build-tsc": "yarn g:tsc --build",
    "build-client": "yarn workspaces foreach --exclude @witcher-3-gwent/ui --parallel --interlaced run build",
    "build-image": "docker build --tag=gwent-ui:${IMAGE_TAG:-latest} --progress=plain --file=Dockerfile --build-arg VERSION=${IMAGE_VERSION:-dev} --build-arg BUILD=${IMAGE_BUILD:-0} ${BUILD_OPTIONS:-} ../../",
    "clean": "yarn g:rimraf build tsconfig.tsbuildinfo && yarn workspaces foreach --parallel --interlaced run clean",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "run-built": "cross-env CLIENT_DIR=../../libs/client/build yarn node build/src/server.js",
    "start": "cross-env CLIENT_DIR=../libs/client/build yarn g:ts-node src/server.ts",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-client watch-built",
    "watch-built": "cross-env CLIENT_DIR=../../libs/client/build yarn g:nodemon --watch build --watch libs/client/build/dynamic-env.js --exec 'yarn node build/src/server.js'",
    "watch-client": "yarn workspaces foreach --exclude @witcher-3-gwent/ui --parallel --interlaced run watch",
    "watch-tsc": "yarn g:tsc --build --watch"
  },
  "dependencies": {
    "@witcher-3-gwent/env": "workspace:*",
    "express": "4.18.2",
    "fs-extra": "11.1.1",
    "replace-in-file": "6.3.5"
  },
  "devDependencies": {
    "@types/express": "4.17.17",
    "@types/fs-extra": "11.0.1",
    "@witcher-3-gwent/client": "workspace:*",
    "cross-env": "7.0.3"
  },
  "workspaces": [
    "libs/*"
  ]
}

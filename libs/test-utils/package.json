{
  "name": "@gwent/test-utils",
  "version": "0.24.1",
  "author": "Adam Boe",
  "description": "Utility functions for tests",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "build": "yarn g:tsc --build",
    "build-all": "yarn g:recurse @gwent/test-utils run build",
    "clean": "yarn g:rimraf build",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "watch": "yarn g:tsc --watch"
  },
  "dependencies": {
    "@gwent/graphql-schema": "workspace:*",
    "mongodb": "7.5.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "jest-junit": "17.0.0",
    "ts-jest": "29.4.12"
  }
}

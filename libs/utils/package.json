    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:tsc --watch"
  },
  "dependencies": {
    "@gwent/graphql-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.12.7",
    "jest-junit": "16.0.0",
    "ts-jest": "29.1.2"
  }
}

{
  "name": "@gwent/utils",
  "version": "0.3.2",
  "author": "Adam Boe",
  "description": "Utility functions",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "build": "yarn g:tsc --build",
    "clean": "yarn g:rimraf build coverage test-results tsconfig.tsbuildinfo",

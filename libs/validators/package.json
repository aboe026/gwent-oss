{
  "name": "@gwent/validators",
  "version": "0.21.0",
  "author": "Adam Boe",
  "description": "Validator functions",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "build": "yarn g:tsc --build",
    "build-all": "yarn g:recurse @gwent/validators run build",
    "clean": "yarn g:rimraf build coverage results tsconfig.tsbuildinfo",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:tsc --watch"
  },
  "dependencies": {
    "@gwent/constants": "workspace:*",
    "@gwent/graphql-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.18.0",
    "jest-junit": "16.0.0",
    "ts-jest": "29.4.6"
  }
}

{
  "name": "@gwent/db-profiler",
  "version": "0.5.0",
  "author": "Adam Boe",
  "description": "Database profiler to analyze operations",
  "type": "module",
  "main": "build/src/index.mjs",
  "types": "build/src/index.d.mts",
  "scripts": {
    "analyze": "yarn g:tsx scripts/analyze.ts",
    "build": "yarn g:tsc --build",
    "clean": "yarn g:rimraf build tsconfig.tsbuildinfo",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "watch": "yarn g:tsc --watch"
  },
  "dependencies": {
    "fs-extra": "11.2.0",
    "mongodb": "6.9.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.5.5"
  }
}

{
  "name": "@gwent/graphql-schema",
  "version": "0.16.1",
  "author": "Adam Boe",
  "description": "Schema definitions for GraphQL API",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "typesVersions": {
    "*": {
      "build/src/index.d.ts": [
        "build/src/index.d.ts"
      ],
      "apollo-typings": [
        "build/generated/apollo/index.d.ts"
      ],
      "apollo-raw-typings": [
        "build/generated/apollo/raw-types.d.ts"
      ],
      "apollo-possible-typings": [
        "build/generated/apollo/fragment-types.d.ts"
      ],
      "*": [
        "build/generated/*",
        "build/src/*"
      ]
    }
  },
  "exports": {
    ".": "./build/src/index.js",
    "./deck-filter": "./build/src/deck-filter.js",
    "./decks-filter": "./build/src/decks-filter.js",
    "./games-filter": "./build/src/games-filter.js",
    "./apollo-typings": "./build/generated/apollo/index.js",
    "./apollo-raw-typings": "./build/generated/apollo/raw-types.js",
    "./apollo-possible-typings": "./build/generated/apollo/fragment-types.js",
    "./database-typings": "./build/generated/database-typings.js",
    "./resolver-typings": "./build/generated/resolver-typings.js",
    "./context": "./build/src/context.js",
    "./node-client": "./build/src/node-client.js"
  },
  "scripts": {
    "add-graphql-to-apollo": "yarn g:ts-node scripts/add-graphql-to-apollo.ts",
    "build": "yarn g:npm-run-all --sequential build-codegen build-node",
    "build-codegen": "graphql-codegen --config codegen.ts",
    "build-node": "yarn g:tsc --build",
    "clean": "yarn g:rimraf build coverage results tsconfig.tsbuildinfo",
    "convert-eol": "yarn g:ts-node scripts/convert-eol.ts",
    "coverage-view": "yarn g:coverage-view",
    "generate-node-client-docs": "yarn g:ts-node scripts/generate-node-client-docs.ts",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-codegen watch-node",
    "watch-codegen": "yarn build-codegen --watch",
    "watch-node": "yarn g:tsc --watch"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "@gwent/constants": "workspace:*",
    "graphql": "16.11.0",
    "graphql-request": "7.3.1",
    "graphql-tag": "2.12.6",
    "moment": "2.30.1",
    "mongodb": "6.20.0",
    "react": "19.2.0",
    "semver": "7.7.3"
  },
  "devDependencies": {
    "@graphql-codegen/add": "6.0.0",
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/client-preset": "5.1.0",
    "@graphql-codegen/fragment-matcher": "6.0.0",
    "@graphql-codegen/schema-ast": "5.0.0",
    "@graphql-codegen/typescript": "5.0.2",
    "@graphql-codegen/typescript-graphql-request": "6.3.0",
    "@graphql-codegen/typescript-mongodb": "3.0.1",
    "@graphql-codegen/typescript-operations": "5.0.2",
    "@graphql-codegen/typescript-resolvers": "5.1.0",
    "@graphql-tools/schema": "10.0.25",
    "@parcel/watcher": "2.5.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.0",
    "@types/semver": "7.7.1",
    "eol": "0.10.0",
    "jest-junit": "16.0.0",
    "ts-jest": "29.4.5"
  }
}

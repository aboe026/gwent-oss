{
  "name": "@gwent/env",
  "version": "0.23.0",
  "author": "Adam Boe",
  "description": "Parse process.env",
  "main": "build/src/env.js",
  "types": "build/src/env.d.ts",
  "scripts": {
    "build": "yarn g:tsc --build",
    "build-all": "yarn g:recurse @gwent/env run build",
    "clean": "yarn g:rimraf build coverage results tsconfig.tsbuildinfo",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:tsc --watch"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "envalid": "8.1.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.12.0",
    "jest-junit": "16.0.0",
    "ts-jest": "29.4.6"
  }
}

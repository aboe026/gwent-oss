{
  "name": "@gwent/lcov-dark-mode",
  "version": "0.16.0",
  "author": "Adam Boe",
  "description": "Jest reporter to make locv HTML files dark mode/theme.",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "build": "npm-run-all --parallel build-tsc build-css",
    "build-css": "copyfiles src/dark-mode.css build",
    "build-tsc": "yarn g:tsc --build",
    "clean": "yarn g:rimraf build",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "watch": "npm-run-all --parallel watch-tsc watch-css",
    "watch-css": "nodemon --watch src/dark-mode.css --exec 'yarn build-css'",
    "watch-tsc": "yarn g:tsc --watch"
  },
  "dependencies": {
    "@jest/reporters": "30.1.2"
  },
  "devDependencies": {
    "copyfiles": "2.4.1",
    "nodemon": "3.1.10",
    "npm-run-all": "4.1.5"
  }
}

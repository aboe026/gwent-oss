{
  "name": "@gwent-oss/msv-ui",
  "version": "0.27.0",
  "author": "Adam Boe",
  "description": "React frontend to play gwent-oss.",
  "main": "src/index.ts",
  "scripts": {
    "build": "yarn g:npm-run-all --parallel build-tsc build-client",
    "build-all": "yarn g:recurse @gwent-oss/msv-ui run build",
    "build-tsc": "yarn g:tsc --build",
    "build-client": "yarn workspaces foreach --worktree --parallel --interlaced --topological-dev --exclude @gwent-oss/msv-ui run build",
    "build-image": "docker build --tag=gwent-oss-ui:${IMAGE_TAG:-latest} --target=ui --build-arg TARGET=ui --progress=plain --build-arg VERSION=${IMAGE_VERSION:-dev} --build-arg BUILD=${IMAGE_BUILD:-0} ${BUILD_OPTIONS:-} ../../",
    "clean": "npm-run-all clean-children clean-root",
    "clean-root": "yarn g:rimraf build coverage results tsconfig.tsbuildinfo",
    "clean-children": "yarn workspaces foreach --worktree --parallel --interlaced --exclude @gwent-oss/msv-ui run clean",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "run-built": "cross-env CLIENT_DIR=../../libs/client/build IMAGES_DIR=../../images yarn node build/src/index.js",
    "start": "yarn g:ts-node src/index.ts",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-client watch-built",
    "watch-built": "cross-env CLIENT_DIR=../../libs/client/build IMAGES_DIR=../../images yarn g:nodemon --watch build --watch libs/client/build/dynamic-env.js --exec 'yarn node build/src/index.js'",
    "watch-client": "yarn workspaces foreach --worktree --parallel --interlaced --exclude @gwent-oss/msv-ui run watch",
    "watch-tsc": "yarn g:tsc --build --watch"
  },
  "dependencies": {
    "@gwent-oss/env": "workspace:*",
    "@gwent-oss/node-utils": "workspace:*",
    "@gwent-oss/utils": "workspace:*",
    "express": "5.2.1",
    "log4js": "6.9.1",
    "replace-in-file": "7.2.0"
  },
  "devDependencies": {
    "@gwent-oss/client": "workspace:*",
    "@types/express": "4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "jest-junit": "17.0.0",
    "ts-jest": "29.4.12"
  },
  "workspaces": [
    "libs/*"
  ]
}

{
  "name": "@gwent/client",
  "version": "0.14.0",
  "author": "Adam Boe",
  "description": "React bundle for Gwent website",
  "main": "src/index.ts",
  "scripts": {
    "build": "yarn g:npm-run-all --sequential build-node build-webpack",
    "build-node": "yarn g:tsc --build",
    "build-webpack": "webpack --mode=production",
    "clean": "yarn g:rimraf build coverage results tsconfig.tsbuildinfo && yarn workspaces foreach --worktree --parallel --interlaced run clean",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-webpack",
    "watch-tsc": "yarn g:tsc --build --watch",
    "watch-webpack": "webpack --watch --progress"
  },
  "dependencies": {
    "@apollo/client": "3.13.9",
    "@gwent/constants": "workspace:*",
    "@gwent/graphql-schema": "workspace:*",
    "@gwent/utils": "workspace:*",
    "@gwent/validators": "workspace:*",
    "graphql": "16.11.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-icons": "5.5.0",
    "react-router": "7.8.0",
    "url-join": "4.0.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@gwent/client-env": "workspace:*",
    "@gwent/env": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.29",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/url-join": "4.0.3",
    "@types/ws": "8.18.1",
    "copy-webpack-plugin": "13.0.0",
    "css-loader": "7.1.2",
    "graphql-ws": "6.0.6",
    "html-webpack-plugin": "5.6.3",
    "jest-junit": "16.0.0",
    "mini-css-extract-plugin": "2.9.3",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "webpack": "5.101.0",
    "webpack-cli": "6.0.1",
    "webpack-shell-plugin-next": "2.3.3"
  },
  "workspaces": [
    "libs/*"
  ]
}

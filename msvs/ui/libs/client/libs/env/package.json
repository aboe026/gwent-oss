{
  "name": "@gwent/client-env",
  "version": "0.23.1",
  "author": "Adam Boe",
  "description": "Client-side runtime dynamic environment variables",
  "main": "build/src/env.js",
  "types": "build/src/env.d.ts",
  "scripts": {
    "build": "yarn g:tsc --build",
    "clean": "yarn g:rimraf build coverage results tsconfig.tsbuildinfo",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:tsc --build --watch"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.12.0",
    "jest-junit": "17.0.0",
    "ts-jest": "29.4.9"
  }
}

{
  "name": "@gwent/msv-api",
  "version": "0.19.0",
  "author": "Adam Boe",
  "description": "GraphQL backend to play Gwent.",
  "main": "src/index.ts",
  "scripts": {
    "build": "yarn g:tsc --build",
    "build-all": "yarn g:recurse @gwent/msv-api run build",
    "build-image": "docker build --tag=gwent-api:${IMAGE_TAG:-latest} --progress=plain --file=Dockerfile --build-arg VERSION=${IMAGE_VERSION:-dev} --build-arg BUILD=${IMAGE_BUILD:-0} ${BUILD_OPTIONS:-} ../../",
    "clean": "yarn g:rimraf build coverage results tsconfig.tsbuildinfo",
    "coverage-view": "yarn g:coverage-view",
    "lint": "yarn g:lint",
    "lint:fix": "yarn g:lint-fix",
    "run-built": "yarn node build/src/index.js",
    "start": "yarn g:ts-node src/index.ts",
    "test-func": "yarn g:jest --test-type=func --runInBand --setupFilesAfterEnv=./test/func/util/setup.ts",
    "test-unit": "yarn g:jest --test-type=unit",
    "watch": "yarn g:npm-run-all --parallel watch-tsc watch-built",
    "watch-built": "yarn g:ts-node scripts/wait-for-initial-build.ts && yarn g:nodemon --watch build --exec 'yarn node build/src/index.js'",
    "watch-tsc": "yarn build --watch"
  },
  "dependencies": {
    "@apollo/server": "5.1.0",
    "@as-integrations/express5": "1.1.2",
    "@graphql-tools/schema": "10.0.27",
    "@gwent/constants": "workspace:*",
    "@gwent/env": "workspace:*",
    "@gwent/graphql-schema": "workspace:*",
    "@gwent/utils": "workspace:*",
    "@gwent/validators": "workspace:*",
    "basic-auth": "2.0.1",
    "body-parser": "2.2.0",
    "connect-mongo": "5.1.0",
    "connection-string": "5.0.0",
    "cookie": "1.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-session": "1.18.2",
    "figlet": "1.9.3",
    "fs-extra": "11.3.2",
    "graphql": "16.12.0",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "6.0.6",
    "log4js": "6.9.1",
    "mongodb": "7.0.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@gwent/test-utils": "workspace:*",
    "@types/basic-auth": "1.1.8",
    "@types/body-parser": "1.19.6",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.2",
    "@types/figlet": "1.7.0",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/semver": "7.7.1",
    "@types/ws": "8.18.1",
    "jest-junit": "16.0.0",
    "ts-jest": "29.4.5"
  }
}

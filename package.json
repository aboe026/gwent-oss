{
  "name": "@gwent/core",
  "version": "0.24.0",
  "author": "Adam Boe",
  "description": "A recreation of the card game Gwent from The Witcher 3: Wild Hunt",
  "scripts": {
    "build": "yarn workspaces foreach --worktree --parallel --interlaced --topological-dev run build",
    "build-images": "yarn workspaces foreach --worktree --parallel --interlaced run build-image",
    "build-libs": "yarn workspaces foreach --worktree --parallel --interlaced --topological-dev --exclude '@gwent/core' --exclude '@gwent/msv-*' --exclude '@gwent/test-*' run build",
    "clean": "npm-run-all clean-children clean-root",
    "clean-children": "yarn workspaces foreach --worktree --parallel --interlaced --exclude @gwent/core run clean",
    "clean-root": "rimraf coverage results",
    "compose-build": "cd compose && docker compose build",
    "compose-start": "cd compose && docker compose start",
    "compose-stop": "cd compose && docker compose stop",
    "compose-up": "cd compose && docker compose up -d",
    "compose-down": "cd compose && docker compose down",
    "coverage-view": "yarn g:coverage-view",
    "lint": "npm-run-all lint-node lint-groovy",
    "lint-fix": "npm-run-all lint-node-fix lint-groovy-fix",
    "lint-groovy": "npm-groovy-lint --ignorepattern '**/.yarn/**' --failon info",
    "lint-groovy-fix": "yarn lint-groovy --fix",
    "lint-node": "yarn g:lint",
    "lint-node-fix": "yarn g:lint-fix",
    "g:coverage-view": "yarn g:ts-node $PROJECT_CWD/scripts/open-in-browser.ts $INIT_CWD/coverage/unit/lcov-report/index.html",
    "g:eslint": "cd $INIT_CWD && eslint --config $PROJECT_CWD/eslint.config.js",
    "g:jest": "cd $INIT_CWD && jest --config $PROJECT_CWD/jest.config.ts --rootDir=$INIT_CWD",
    "g:lint": "yarn g:eslint $INIT_CWD && yarn g:prettier --check $INIT_CWD",
    "g:lint-fix": "yarn g:eslint --fix $INIT_CWD && yarn g:prettier --write $INIT_CWD",
    "g:nodemon": "cd $INIT_CWD && nodemon",
    "g:npm-run-all": "cd $INIT_CWD && npm-run-all",
    "g:prettier": "cd $INIT_CWD && prettier --config $PROJECT_CWD/.prettierrc.json --ignore-path $PROJECT_CWD/.prettierignore",
    "g:recurse": "yarn workspaces foreach --recursive --parallel --topological-dev --interlaced --from",
    "g:rimraf": "cd $INIT_CWD && rimraf",
    "g:ts-node": "cd $INIT_CWD && ts-node",
    "g:tsc": "cd $INIT_CWD && tsc",
    "run-built": "yarn workspaces foreach --worktree --parallel --interlaced run run-built",
    "start": "yarn workspaces foreach --worktree --parallel --interlaced --exclude '@gwent/test-*' run start",
    "test": "npm-run-all --sequential lint test-unit test-func test-e2e",
    "test-e2e": "cd test/e2e && yarn start",
    "test-func": "yarn g:jest --test-type=func --runInBand --setupFilesAfterEnv=./msvs/api/test/func/util/setup.ts",
    "test-unit": "yarn g:jest --test-type=unit",
    "upgrade-dependencies": "yarn g:ts-node scripts/upgrade-dependencies",
    "watch": "yarn workspaces foreach --worktree --parallel --interlaced --jobs unlimited run watch"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gwent/lcov-dark-mode": "workspace:*",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-jsdoc": "63.3.2",
    "fs-extra": "11.4.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-junit": "17.0.0",
    "jest-util": "30.4.1",
    "jiti": "2.7.0",
    "nodemon": "3.1.14",
    "npm-groovy-lint": "18.0.0",
    "npm-run-all": "4.1.5",
    "open": "8.4.2",
    "prettier": "3.9.6",
    "replace-in-file": "7.2.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "workspaces": [
    "msvs/*",
    "libs/*",
    "test/*"
  ],
  "packageManager": "yarn@4.18.0"
}

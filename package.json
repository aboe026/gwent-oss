{
  "name": "@gwent/core",
  "version": "0.2.1",
  "author": "Adam Boe",
  "description": "A recreation of the card game Gwent from The Witcher 3: Wild Hunt",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "yarn workspaces foreach --worktree --parallel --interlaced run build",
    "build-images": "yarn workspaces foreach --worktree --parallel --interlaced run build-image",
    "clean": "npm-run-all clean-children clean-root",
    "clean-children": "yarn workspaces foreach --worktree --parallel --interlaced --exclude @gwent/core run clean",
    "clean-root": "rimraf coverage test-results",
    "compose-build": "cd compose && docker compose build",
    "compose-up": "cd compose && docker compose up -d",
    "compose-down": "cd compose && docker compose down",
    "coverage-view": "yarn g:coverage-view",
    "lint": "npm-run-all lint-node lint-groovy",
    "lint-fix": "npm-run-all lint-node-fix lint-groovy-fix",
    "lint-groovy": "npm-groovy-lint --ignorepattern '**/.yarn/**' --failon info",
    "lint-groovy-fix": "yarn lint-groovy --fix",
    "lint-node": "yarn g:lint",
    "lint-node-fix": "yarn g:lint-fix",
    "g:coverage-view": "ts-node $PROJECT_CWD/scripts/open-in-browser.ts $INIT_CWD/coverage/unit/lcov-report/index.html",
    "g:eslint": "cd $INIT_CWD && eslint --config $PROJECT_CWD/.eslintrc.json",
    "g:jest": "cd $INIT_CWD && jest --config $PROJECT_CWD/jest.config.ts --rootDir=$INIT_CWD",
    "g:lint": "yarn g:eslint $INIT_CWD && yarn g:prettier --check $INIT_CWD",
    "g:lint-fix": "yarn g:eslint --fix . && yarn g:prettier --write .",
    "g:nodemon": "cd $INIT_CWD && nodemon",
    "g:npm-run-all": "cd $INIT_CWD && npm-run-all",
    "g:prettier": "cd $INIT_CWD && prettier --config $PROJECT_CWD/.prettierrc.json --ignore-path $PROJECT_CWD/.prettierignore",
    "g:rimraf": "cd $INIT_CWD && rimraf",
    "g:ts-node": "cd $INIT_CWD && ts-node",
    "g:tsc": "cd $INIT_CWD && tsc",
    "run-built": "yarn workspaces foreach --worktree --parallel --interlaced run run-built",
    "start": "yarn workspaces foreach --worktree --parallel --interlaced --exclude @gwent/e2e-tests run start",
    "test": "npm-run-all lint test-unit test-func test-e2e",
    "test-e2e": "cd test/e2e && yarn build && yarn start",
    "test-func": "yarn g:jest --test-type=func --runInBand",
    "test-unit": "yarn g:jest --test-type=unit",
    "upgrade-dependencies": "ts-node scripts/upgrade-dependencies",
    "watch": "yarn workspaces foreach --worktree --parallel --interlaced run watch"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.3",
    "@types/jest": "29.5.7",
    "@types/node": "20.8.10",
    "@typescript-eslint/eslint-plugin": "6.10.0",
    "@typescript-eslint/parser": "6.10.0",
    "cross-env": "7.0.3",
    "eslint": "8.53.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "4.2.1",
    "fs-extra": "11.1.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "16.0.0",
    "nodemon": "3.0.1",
    "npm-groovy-lint": "12.0.1",
    "npm-run-all": "4.1.5",
    "open": "8.4.2",
    "prettier": "2.8.8",
    "replace-in-file": "7.0.2",
    "rimraf": "5.0.5",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.1",
    "typescript": "5.2.2"
  },
  "workspaces": [
    "svcs/*",
    "libs/*",
    "test/*"
  ],
  "packageManager": "yarn@4.0.1"
}
